{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "cloudfit",
  "version": "0.1.1",
  "description": "Fits Slurm jobs to what they actually used: trims the CPU and RAM you over-asked for, drives the GPU you under-used, and states the sample size behind every number.",
  "author": {
    "name": "Youzhi Yu",
    "email": "youzhi@uchicago.edu"
  },
  "skills": [
    "./skills/cloudfit"
  ],
  "commands": [
    "./commands/fit.md"
  ],
  "agents": [
    "./agents/cloudfit.md"
  ],
  "mcpServers": {
    "cloudfit": {
      "command": "/software/python-miniforge-25.3.0-el8-x86_64/envs/AI/bin/python",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/cloudfit/server.py"
      ]
    }
  }
}
